{
  "name": "youtube-transcript-ts",
  "version": "2.0.2",
  "packageManager": "pnpm@10.4.1",
  "description": "TypeScript implementation of YouTube Transcript API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wickes1/youtube-transcript-ts.git"
  },
  "bugs": {
    "url": "https://github.com/wickes1/youtube-transcript-ts/issues"
  },
  "homepage": "https://github.com/wickes1/youtube-transcript-ts#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "smoke": "node scripts/smoke.mjs",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,__tests__,examples}/**/*.ts\"",
    "lint:fix": "eslint \"{src,__tests__,examples}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\" \"examples/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\" \"examples/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check:types-pack": "attw --pack",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky || true",
    "prepack": "pnpm clean && pnpm build",
    "prepublishOnly": "pnpm check && pnpm build && pnpm smoke"
  },
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "subtitles"
  ],
  "author": "wickes1",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "html-entities": "^2.6.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
